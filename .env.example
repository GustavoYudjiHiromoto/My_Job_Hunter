# =====================================================================
# Job Hunter - Configurações de Ambiente (Opcionais)
# =====================================================================

# Provedores de Vagas
# Chave da OpenWeb Ninja para busca no JSearch (opcional, plano gratuito disponível)
JSEARCH_API_KEY=

# Tokens de Job Boards do Greenhouse separados por vírgula (ex: "nubank,airbnb")
GREENHOUSE_BOARDS=

# Identificadores de sites do Lever separados por vírgula e região ("global" ou "eu")
LEVER_SITES=
LEVER_REGION=global

# Análise de Relevância com Inteligência Artificial (OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Notificações e Alertas por E-mail (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=

# Banco de Dados (Padrão: SQLite local)
# DATABASE_URL=sqlite:///job_hunter.db
